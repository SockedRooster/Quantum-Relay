<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>QuantumRelay</RootNamespace>
    <AssemblyName>QuantumRelay</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Authors>SockedRooster</Authors>
    <Company>RoosterWorks</Company>
    <Product>Quantum Relay</Product>
    <Description>Stable multi-tier quantum relay routing through Promised Worlds wormholes.</Description>
    <Copyright>Copyright © 2026 RoosterWorks</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <KSPRoot Condition=" '$(KSPRoot)' == '' ">A:\SteamLibrary\steamapps\common\Kerbal Space Program</KSPRoot>
    <KSPManaged Condition=" '$(KSPManaged)' == '' ">$(KSPRoot)\KSP_x64_Data\Managed</KSPManaged>
    <OutputPath>..\..\GameData\QuantumRelay\Plugins\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="CommNetNetworkInstaller.cs" />
    <Compile Include="Configuration/BridgeLoader.cs" />
    <Compile Include="Core/ActiveQuantumLink.cs" />
    <Compile Include="Core/QuantumBridge.cs" />
    <Compile Include="Core/QuantumRelayStates.cs" />
    <Compile Include="Core/RelayDeploymentController.cs" />
    <Compile Include="Core/RelayPowerController.cs" />
    <Compile Include="Core/RelayStateMachine.cs" />
    <Compile Include="Core/RelaySynchronizationController.cs" />
    <Compile Include="GatewayScanner.cs" />
    <Compile Include="Managers/QuantumBridgeManager.cs" />
    <Compile Include="ModuleQuantumRelay.cs" />
    <Compile Include="PowerManager.cs" />
    <Compile Include="QuantumCommNetwork.cs" />
    <Compile Include="QuantumGatewayManager.cs" />
    <Compile Include="QuantumRelayBootstrap.cs" />
    <Compile Include="QuantumRelayCommands.cs" />
    <Compile Include="QuantumRelayConstants.cs" />
    <Compile Include="QuantumRelayGui.cs" />
    <Compile Include="QuantumRelayInfo.cs" />
    <Compile Include="QuantumRelayMissionControl.cs" />
    <Compile Include="QuantumRelayNotifications.cs" />
    <Compile Include="QuantumRelayRegistry.cs" />
    <Compile Include="QuantumRelayRuntimeState.cs" />
    <Compile Include="QuantumRelaySettings.cs" />
    <Compile Include="ReflectorDetector.cs" />
    <Compile Include="WormholeScanner.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(KSPManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSPManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSPManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(KSPManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(KSPManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
