<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>QuantumRelay</RootNamespace>
    <AssemblyName>QuantumRelay</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Authors>SockedRooster</Authors>
    <Company>RoosterWorks</Company>
    <Product>Quantum Relay</Product>
    <Description>Stable multi-tier quantum relay routing through Promised Worlds wormholes.</Description>
    <Copyright>Copyright © 2026 RoosterWorks</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <KSPRoot Condition=" '$(KSPRoot)' == '' ">D:\SteamLibrary\steamapps\common\Kerbal Space Program</KSPRoot>
    <KSPManaged Condition=" '$(KSPManaged)' == '' ">$(KSPRoot)\KSP_x64_Data\Managed</KSPManaged>
    <OutputPath>..\GameData\QuantumRelay\Plugins\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="CommNetNetworkInstaller.cs" />
    <Compile Include="Configuration/BridgeLoader.cs" />
    <Compile Include="Core/ActiveQuantumLink.cs" />
    <Compile Include="Core/QuantumBridge.cs" />
    <Compile Include="Core/QuantumNetwork.cs" />
    <Compile Include="Core/QuantumManager.cs" />
    <Compile Include="Core/QuantumRouteCache.cs" />
    <Compile Include="Core/QuantumRouter.cs" />
    <Compile Include="Core/QuantumRelayStates.cs" />
    <Compile Include="Core/RelayDeploymentController.cs" />
    <Compile Include="Core/RelayPowerController.cs" />
    <Compile Include="Core/RelayStateMachine.cs" />
    <Compile Include="Core/RelaySynchronizationController.cs" />
    <Compile Include="GatewayScanner.cs" />
    <Compile Include="GatewayDistance.cs" />
    <Compile Include="Managers/QuantumBridgeManager.cs" />
    <Compile Include="ModuleQuantumRelay.cs" />
    <Compile Include="Models/QuantumRoute.cs" />
    <Compile Include="Models/RouteKey.cs" />
    <Compile Include="PowerManager.cs" />
    <Compile Include="QuantumCommNetwork.cs" />
    <Compile Include="QuantumGatewayManager.cs" />
    <Compile Include="QuantumRelayBootstrap.cs" />
    <Compile Include="QuantumRelayCommands.cs" />
    <Compile Include="QuantumRelayConstants.cs" />
    <Compile Include="QuantumRelayEffects.cs" />
    <Compile Include="QuantumRelayVisualController.cs" />
    <Compile Include="RelayVisualState.cs" />
    <Compile Include="QuantumRelayGui.cs" />
    <Compile Include="QuantumRelayNetworkMap.cs" />
    <Compile Include="QuantumRelayInfo.cs" />
    <Compile Include="QuantumRouteDetector.cs" />
    <Compile Include="QuantumRelayFlightHud.cs" />
    <Compile Include="QuantumRelayMissionControl.cs" />
    <Compile Include="QuantumRelayNotifications.cs" />
    <Compile Include="QuantumRelayRegistry.cs" />
    <Compile Include="QuantumRelayRuntimeState.cs" />
    <Compile Include="QuantumRelaySettings.cs" />
    <Compile Include="QuantumRelaySettingsNode.cs" />
    <Compile Include="RelayClass.cs" />
    <Compile Include="RelayDefinition.cs" />
    <Compile Include="ReflectorDetector.cs" />
    <Compile Include="Services/QuantumRoutingService.cs" />
    <Compile Include="Scenario/QuantumRelayScenario.cs" />
    <Compile Include="WormholeScanner.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(KSPManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSPManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSPManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(KSPManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(KSPManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(KSPManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(KSPManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(KSPManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(KSPManaged)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CopyQuantumRelayDistribution" AfterTargets="Build">
    <ItemGroup>
      <QuantumRelayAsset Include="$(MSBuildProjectDirectory)\..\Distribution\QuantumRelay\**\*" />
      <QuantumRelayPartCfg Include="$(MSBuildProjectDirectory)\Parts\*.cfg" />
    </ItemGroup>
    <Copy SourceFiles="@(QuantumRelayAsset)"
          DestinationFiles="@(QuantumRelayAsset->'$(MSBuildProjectDirectory)\..\GameData\QuantumRelay\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(QuantumRelayPartCfg)"
          DestinationFolder="$(MSBuildProjectDirectory)\..\GameData\QuantumRelay\Parts"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\LICENSE"
          DestinationFolder="$(MSBuildProjectDirectory)\..\GameData\QuantumRelay"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyQuantumRelaySounds" AfterTargets="Build">
    <MakeDir Directories="..\GameData\QuantumRelay\Sounds" />
    <Copy SourceFiles="Sounds\Activation.wav;Sounds\TransmissionPulse.ogg"
          DestinationFolder="..\GameData\QuantumRelay\Sounds"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
