      "name": "PromisedWorldsDebdeb"
    },
    {
      "name": "PromisedWorldsTuun"
    }
  ],
  "supports": [
    {
      "name": "Kerbalism"
    }
  ],
  "resources": {
    "homepage": "https://github.com/SockedRooster/Quantum-Relay",
    "repository": "https://github.com/SockedRooster/Quantum-Relay",
    "bugtracker": "https://github.com/SockedRooster/Quantum-Relay/issues"
  },
  "install": [
    {
      "find": "QuantumRelay",
      "install_to": "GameData"
    }
  ],
  "x_netkan_github": {
    "prereleases": false
  }
}
