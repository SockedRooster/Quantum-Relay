  "$kref": "#/ckan/github/SockedRooster/Quantum-Relay/asset_match/^Quantum-Relay-v[0-9]+[.][0-9]+[.][0-9]+-GameData[.]zip$",
  "x_netkan_version_edit": {
    "find": "^[vV](?<version>.*)$",
    "replace": "${version}"
  },
  "ksp_version": "1.12.5",
  "tags": [
    "parts",
    "plugin"
  ],
  "depends": [
    {
      "name": "ModuleManager"
    }
  ],
  "suggests": [
